                                            <i class="fa-brands fa-linkedin"></i>

                                        </a>
                                    </li>

                                    <li>
                                        <a href="#"
                                           aria-label="pinterest">

                                            <i class="fa-brands fa-pinterest"></i>

                                        </a>
                                    </li>

                                </ul>

                            </div>
                            <!-- /Social -->

                        </div>

                    </div>
                    <!-- /Newsletter -->

                </div>

            </div>

        </div>


        <!-- Footer Bottom -->
        <div class="footer-bottom">

            <div class="container">

                <div class="copyright">


                    <div class="copyright-text mb-0">

                        <p class="mb-0">
                            Copyright © 2026 Doccure. All Rights Reserved
                        </p>

                    </div>


                    <!-- Copyright Menu -->
