												   asp-route-MinRating="@minRating"
												   asp-route-Sort="@sort"
												   class="page-link prev"
												   data-doctor-page>
													Prev
												</a>
											}
											else
											{
												<span class="page-link prev">Prev</span>
											}
										</li>

										@for (var page = 1; page <= totalPages; page++)
										{
											<li>
												<a href="/Doctors?PageNumber=@(page)&PageSize=@Model.PageSize"
   class="page-link @(page == currentPage ? "active" : "")"
   data-doctor-page>
    @(page)
</a>
											</li>
										}

										<li>
											@if (currentPage < totalPages)
											{
												<a asp-controller="Doctors"
												   asp-action="Index"
												   asp-route-PageNumber="@(currentPage + 1)"
												   asp-route-PageSize="@Model.PageSize"
												   asp-route-Search="@search"
												   asp-route-SpecializationId="@specializationId"
												   asp-route-Available="@available"
												   asp-route-MinPrice="@minPrice"
												   asp-route-MaxPrice="@maxPrice"
												   asp-route-MinRating="@minRating"
												   asp-route-Sort="@sort"

												   class="page-link next"
												   data-doctor-page>
													Next
												</a>
											}
											else
											{
												<span class="page-link next">Next</span>
											}
										</li>

									</ul>

								</div>

							</div>
						}

					</div>
				</div>
				</div>
			</div>
		</div>
