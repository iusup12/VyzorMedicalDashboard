</aside><div class="main-content app-content">
<div class="container-fluid page-container main-body-container">
    <div class="mb-3 page-header-breadcrumb"><div class="d-flex align-center justify-content-between flex-wrap gap-2"><h1 class="page-title fw-medium fs-18 mb-0">Products</h1><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="#!">Dashboards</a></li><li class="breadcrumb-item"><a href="#!">Ecommerce</a></li><li class="breadcrumb-item active" aria-current="page">Products</li></ol></div></div><div class="row">
    <div class="col-xl-12">
        <div class="custom-card card">
           <div class="p-0 card-body">
            <div id="product-table" class="grid-card-table">
                <div>
                    <div role="complementary" class="gridjs gridjs-container" style="width: 100%;">
                        <div class="gridjs-wrapper" style="height: auto;">
                            <table role="grid" class="gridjs-table" style="height: auto;">
                               <thead class="gridjs-thead">
    <tr class="gridjs-tr">

      
        <th data-column-id="#" class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 37px; width: 37px;">
            <div class="gridjs-th-content">#</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

        <!-- Doctor ID -->
        <th data-column-id="doctorId"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 90px; width: 90px;">
            <div class="gridjs-th-content">Doctor ID</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

        <!-- Doctor -->
        <th data-column-id="doctorName"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 200px; width: 200px;">
            <div class="gridjs-th-content">Doctor</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

        
        <th data-column-id="specialization"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 150px; width: 150px;">
            <div class="gridjs-th-content">Specialization</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

      
        <th data-column-id="appointmentPrice"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 120px; width: 120px;">
            <div class="gridjs-th-content">Appointment Price</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

      
        <th data-column-id="rating"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 90px; width: 90px;">
            <div class="gridjs-th-content">Rating</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

        
        <th data-column-id="status"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 90px; width: 90px;">
            <div class="gridjs-th-content">Status</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

        
        <th data-column-id="actions"
            class="gridjs-th gridjs-th-sort"
            tabindex="0"
            style="min-width: 100px; width: 100px;">
            <div class="gridjs-th-content">Actions</div>
            <button tabindex="-1"
                    aria-label="Sort column ascending"
                    title="Sort column ascending"
                    class="gridjs-sort gridjs-sort-neutral">
            </button>
        </th>

    </tr>
</thead>
<tbody class="gridjs-tbody">

    @if (Model?.Items != null && Model.Items.Any())
    {
        foreach (var doctor in Model.Items)
        {
            <tr class="gridjs-tr">

                <!-- # -->
                <td data-column-id="#" class="gridjs-td">
                    <span>
                        <input class="form-check-input"
                               type="checkbox"
                               id="doctor-@doctor.Id"
                               value="@doctor.Id"
                               aria-label="Select doctor">
                    </span>
                </td>

                <!-- Doctor ID -->
                <td data-column-id="doctorId" class="gridjs-td">
                    <span>
                        <a asp-controller="Doctors"
                           asp-action="Details"
                           asp-route-id="@doctor.Id">
                            @doctor.Id
                        </a>
                    </span>
                </td>

                <!-- Doctor -->
                <td data-column-id="doctorName" class="gridjs-td">
                    <span>
                        <a asp-controller="Doctors"
                           asp-action="Details"
                           asp-route-id="@doctor.Id"
                           class="text-decoration-none">

                            <div class="d-flex align-items-center gap-3">

                                <div class="lh-1">
                                    <span class="avatar avatar-lg bg-primary-transparent">
                                        <span class="fw-semibold">
                                            @if (!string.IsNullOrWhiteSpace(doctor.FullName))
                                            {
                                                @doctor.FullName.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                @:?
                                            }
                                        </span>
                                    </span>
                                </div>

                                <div>
                                    <span class="d-block fw-semibold">
                                        @doctor.FullName
                                    </span>
                                </div>

                            </div>

                        </a>
                    </span>
                </td>

                <!-- Specialization -->
                <td data-column-id="specialization" class="gridjs-td">
                    <span>
                        @doctor.SpecializationName
                    </span>
                </td>

                <!-- Appointment Price -->
                <td data-column-id="appointmentPrice" class="gridjs-td">
                    <span>
                        @doctor.AppointmentPrice.ToString("0.00")
                    </span>
                </td>

                <!-- Rating -->
                <td data-column-id="rating" class="gridjs-td">

                    <span class="text-warning">
                        <i class="ri-star-fill"></i>
                    </span>

                    <span>
                        @doctor.Rating.ToString("0.0")
                    </span>

                </td>

                <!-- Status -->
                <td data-column-id="status" class="gridjs-td">

                    @if (doctor.IsActive)
                    {
                        <span class="badge bg-success-transparent">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-transparent">
                            Inactive
                        </span>
                    }

                </td>

                <!-- Actions -->
                <td data-column-id="actions" class="gridjs-td">

                    <span>

                                                        <a href="/Doctors/Details/@doctor.Id"
                                                           class="btn btn-sm btn-primary-transparent doctor-view-btn"
                                                           title="View">
                                                            <i class="ri-eye-line"></i>
                                                        </a>

                                                        <a href="/Admin/Doctors/Edit/@doctor.Id"
                                                           class="btn btn-sm btn-warning-transparent doctor-edit-btn"
                                                           title="Edit">

                                                            <i class="ri-edit-line"></i>

                                                        </a>

                        <!-- Delete - Admin -->
                                                        <form action="/Admin/Doctors/Delete/@doctor.Id"
                                                              method="post"
                                                              class="d-inline">

                                                            @Html.AntiForgeryToken()

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-danger-transparent"
                                                                    title="Delete"
                                                                    onclick="return confirm('Are you sure you want to delete this doctor?');">

                                                                <i class="ri-delete-bin-line"></i>

                                                            </button>

                                                        </form>

                    </span>

                </td>

            </tr>
        }
    }
    else
    {
        <tr class="gridjs-tr">

            <td colspan="8"
                class="gridjs-td text-center py-5">

                <span class="text-muted">
                    No doctors found.
                </span>

            </td>

        </tr>
    }

</tbody>


                                </table>
                            </div><div class="gridjs-footer"></div><div id="gridjs-temp" class="gridjs-temp"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
