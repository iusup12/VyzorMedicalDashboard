@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Vyzor Medical
    </title>

    <meta name="description"
          content="Vyzor Medical - medical center and online appointment system" />

    <link rel="shortcut icon"
          href="~/assets/Doccure/img/favicon.png"
          type="image/x-icon" />

    <!-- Doccure Theme Settings -->
    <script src="~/assets/Doccure/js/theme-script.js"></script>

    <!-- Doccure CSS -->
    <link rel="stylesheet"
          href="~/assets/Doccure/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/fontawesome/css/fontawesome.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/fontawesome/css/all.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/iconsax.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/ion-rangeslider/css/ion.rangeSlider.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/ion-rangeslider/css/ion.rangeSlider.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/bootstrap-datetimepicker.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/feather.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/style.min.css" />

    <!-- Vyzor custom fixes -->
    <link rel="stylesheet"
          href="~/assets/Doccure/css/icon-fix.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- Main Wrapper -->
    <div class="main-wrapper">

        <main role="main">
            @RenderBody()
        </main>

    </div>
    <!-- /Main Wrapper -->
    <!-- Doccure JavaScript -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/assets/Doccure/js/bootstrap.bundle.min.js"></script>

    <script src="~/assets/Doccure/js/feather.min.js"></script>

    <script src="~/assets/Doccure/js/fancybox-vanilla.js"></script>

    <script src="~/assets/Doccure/plugins/ion-rangeslider/js/custom-rangeslider.js"></script>
    <script src="~/assets/Doccure/plugins/ion-rangeslider/js/ion.rangeSlider.js"></script>
    <script src="~/assets/Doccure/plugins/ion-rangeslider/js/custom-rangeslider.min.js"></script>
    <script src="~/assets/Doccure/js/script.min.js"></script>

    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>