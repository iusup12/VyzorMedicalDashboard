@model Vyzor.Application.DTO.Doctor.DoctorEditDTO

@{
    Layout = "~/Views/Shared/Dashboard/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Doctor";
}

<div class="container-fluid">

    
    <div class="d-md-flex d-block align-items-center justify-content-between my-4">
        <div>
            <h1 class="page-title fw-semibold fs-18 mb-0">
                Add Doctor
            </h1>

            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/Admin/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="/Admin/Doctors">
                            Doctors
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        Add Doctor
                    </li>
                </ol>
            </nav>
        </div>

        <div class="mt-2 mt-md-0">
            <a href="/Admin/Doctors"
               class="btn btn-light">
                <i class="ri-arrow-left-line me-1"></i>
                Back to Doctors
            </a>
        </div>
    </div>


    <div class="row">

        <div class="col-xl-8">

            <div class="card custom-card">

                <div class="card-header">
                    <div class="card-title">
                        Doctor Information
                    </div>
                </div>

                <div class="card-body">

                    <form action="/Admin/Doctors/Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row gy-4">

                            <!-- FULL NAME -->
                            <div class="col-xl-12">

                                <label for="FullName"
                                       class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       id="FullName"
                                       name="FullName"
                                       class="form-control"
                                       value="Test Doctor"
                                       placeholder="Enter doctor's full name" />

                            </div>


                            <!-- SPECIALIZATION -->
                            <div class="col-xl-6">

                                <label for="SpecializationId"
                                       class="form-label">
                                    Specialization ID
                                </label>

                                <input type="number"
                                       id="SpecializationId"
                                       name="SpecializationId"
                                       class="form-control"
                                       value="1"
                                       min="1" />

                            </div>


                            <!-- EXPERIENCE -->
                            <div class="col-xl-6">

                                <label for="ExperienceYears"
                                       class="form-label">
                                    Experience
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           id="ExperienceYears"
                                           name="ExperienceYears"
                                           class="form-control"
                                           value="10"
                                           min="0"
                                           max="100" />

                                    <span class="input-group-text">
                                        years
                                    </span>

                                </div>

                            </div>


                            <!-- APPOINTMENT PRICE -->
                            <div class="col-xl-6">

                                <label for="AppointmentPrice"
                                       class="form-label">
                                    Appointment Price
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           id="AppointmentPrice"
                                           name="AppointmentPrice"
                                           class="form-control"
                                           value="100"
                                           min="0"
                                           step="0.01" />

                                    <span class="input-group-text">
                                        €
                                    </span>

                                </div>

                            </div>


                            <!-- IMAGE URL -->
                            <div class="col-xl-6">

                                <label for="ImageUrl"
                                       class="form-label">
                                    Image URL
                                </label>

                                <input type="text"
                                       id="ImageUrl"
                                       name="ImageUrl"
                                       class="form-control"
                                       value=""
                                       placeholder="https://example.com/image.jpg" />

                            </div>


                           
                            <div class="col-xl-12">

                                <label for="About"
                                       class="form-label">
                                    About Doctor
                                </label>

                                <textarea id="About"
                                          name="About"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Enter information about the doctor">Test doctor</textarea>

                            </div>

                        </div>


                     
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a href="/Admin/Doctors"
                               class="btn btn-light">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="ri-add-line me-1"></i>
                                Create Doctor
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        
        <div class="col-xl-4">

            <div class="card custom-card">

                <div class="card-header">
                    <div class="card-title">
                        Information
                    </div>
                </div>

                <div class="card-body">

                    <p class="text-muted mb-0">
                        This is a temporary test form for creating
                        a doctor. After the POST request is confirmed,
                        we will replace the test fields with the
                        normal specialization dropdown and validation.
                    </p>

                </div>

            </div>

        </div>

    </div>
    

</div>
