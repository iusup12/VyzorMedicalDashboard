@section Scripts {
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			if (window.jQuery && typeof jQuery.fn.ionRangeSlider === 'function') {
				var minInput = document.getElementById('minPrice');
				var maxInput = document.getElementById('maxPrice');
				var slider = document.getElementById('range_03');

				if (slider) {
					var currentMin = parseFloat(minInput.value) || 0;
					var currentMax = parseFloat(maxInput.value) || 5000;

					jQuery(slider).ionRangeSlider({
						type: 'double',
						min: 0,
						max: 5000,
						from: currentMin,
						to: currentMax,
						onFinish: function (data) {
							minInput.value = data.from;
							maxInput.value = data.to;
						}
					});
				}
			}
		});
	</script>
	<script src="~/js/doctors.js" asp-append-version="true"></script>
}