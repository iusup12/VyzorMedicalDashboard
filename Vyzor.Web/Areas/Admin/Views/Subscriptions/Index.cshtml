
@using Vyzor.Application.DTO.Subscription
@model Vyzor.Web.Areas.Admin.Models.AdminSubscriptionPlansIndexViewModel

@{
    ViewData["Title"] = "Subscription Plans";
    Layout = "~/Views/Shared/Dashboard/_DashboardLayout.cshtml";
}

<div class="main-content app-content">
    <div class="container-fluid">
        <nav class="main-menu-container nav nav-pills flex-column sub-open">

    <div class="side-menu__label">
        MAIN
    </div>

    <!-- Dashboard -->
    <a asp-area="Admin"
       asp-controller="Dashboard"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-dashboard-line side-menu__icon"></i>
        <span class="side-menu__label">
            Dashboard
        </span>
    </a>

    <!-- Doctors -->
    <a asp-area="Admin"
       asp-controller="Doctors"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-stethoscope-line side-menu__icon"></i>
        <span class="side-menu__label">
            Doctors
        </span>
    </a>

   

    <!-- Appointments -->
    <a asp-area="Admin"
       asp-controller="Appointments"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-calendar-check-line side-menu__icon"></i>
        <span class="side-menu__label">
            Appointments
        </span>
    </a>

    <!-- Appointment Cart -->
    <a asp-area="Admin"
       asp-controller="AppointmentCart"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-shopping-cart-2-line side-menu__icon"></i>
        <span class="side-menu__label">
            Appointment Cart
        </span>
    </a>

    <!-- Specializations -->
    <a asp-area="Admin"
       asp-controller="Specializations"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-heart-pulse-line side-menu__icon"></i>
        <span class="side-menu__label">
            Specializations
        </span>
    </a>

   

    <!-- Subscriptions -->
    <a asp-area="Admin"
       asp-controller="Subscriptions"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-vip-crown-line side-menu__icon"></i>
        <span class="side-menu__label">
            Subscriptions
        </span>
    </a>


    <div class="side-menu__label mt-3">
        MANAGEMENT
    </div>

   

   
    <!-- Technical Logs -->
    <a asp-area="Admin"
       asp-controller="TechnicalLogs"
       asp-action="Index"
       class="side-menu__item">
        <i class="ri-terminal-box-line side-menu__icon"></i>
        <span class="side-menu__label">
            Technical Logs
        </span>
    </a>


    <!-- AI Helper -->
    <div class="ai-helper-card mt-4 mx-2 p-3 rounded-3">

        <div class="fw-semibold mb-1">
            AI Helper
        </div>

        <div class="text-muted fs-11 mb-2">
            Ask AI to help you manage your dashboard.
        </div>

        <button type="button"
                class="btn btn-primary btn-sm w-100">
            Open Helper
        </button>

    </div>

</nav>

        <!-- Page Header -->
        <div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">

            <div>
                <h1 class="page-title fw-semibold fs-18 mb-0">
                    Subscription Plans
                </h1>

                <span class="text-muted">
                    Manage subscription plans for patients
                </span>
            </div>

            <div class="ms-md-1 ms-0">
                <a asp-area="Admin"
                   asp-controller="Subscriptions"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="ri-add-line me-1"></i>
                    Add Plan

                </a>
            </div>

        </div>
        <!-- Page Header -->


        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="ri-check-line me-1"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">

                <div asp-validation-summary="All"></div>

            </div>
        }


        <!-- Pricing Header -->
        <div class="row">

            <div class="col-xl-12">

                <div class="text-center mb-4">

                    <h3 class="fw-semibold">
                        Subscription Plans
                    </h3>

                    <p class="text-muted mb-0">
                        Manage subscription plans available in Vyzor Medical Dashboard.
                    </p>

                </div>

            </div>

        </div>


        <!-- Pricing Cards -->
        <div class="row justify-content-center">

            @if (Model?.Plans?.Items != null && Model.Plans.Items.Count > 0)
            {
                var index = 0;

                foreach (var plan in Model.Plans.Items)
                {
                    var colorIndex = index % 3;

                    string cardClass;
                    string iconClass;
                    string icon;

                    if (colorIndex == 0)
                    {
                        cardClass = "pricing-primary";
                        iconClass = "bg-primary-transparent svg-primary";
                        icon = "ri-user-line";
                    }
                    else if (colorIndex == 1)
                    {
                        cardClass = "pricing-success";
                        iconClass = "bg-success-transparent svg-success";
                        icon = "ri-group-line";
                    }
                    else
                    {
                        cardClass = "pricing-warning";
                        iconClass = "bg-warning-transparent svg-warning";
                        icon = "ri-building-line";
                    }


                    <div class="col-xl-4 col-lg-6 col-md-6 mb-4">

                        <div class="card custom-card dashboard-main-card pricing-card @cardClass h-100">

                            <div class="card-body p-4">


                                <!-- Plan Header -->
                                <div class="d-flex align-items-center justify-content-between mb-3">

                                    <div class="d-flex align-items-center">

                                        <div class="avatar avatar-md @iconClass me-3">

                                            <span class="avatar avatar-md">
                                                <i class="@icon fs-24"></i>
                                            </span>

                                        </div>

                                        <div>

                                            <h5 class="fw-semibold mb-1">
                                                @plan.Name
                                            </h5>

                                            <span class="text-muted fs-12">
                                                @plan.DurationDays days
                                            </span>

                                        </div>

                                    </div>


                                    <!-- Status -->
                                    @if (plan.IsActive)
                                    {
                                        <span class="badge bg-success-transparent text-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-transparent text-danger">
                                            Inactive
                                        </span>
                                    }

                                </div>


                                <!-- Description -->
                                @if (!string.IsNullOrWhiteSpace(plan.Description))
                                {
                                    <p class="text-muted fs-13 mb-3">
                                        @plan.Description
                                    </p>
                                }


                                <!-- Price -->
                                <div class="mb-4">

                                    <div class="d-flex align-items-baseline">

                                        <h2 class="fw-semibold mb-0">
                                            @plan.Price.ToString("0.00")
                                        </h2>

                                        <span class="text-muted ms-2">
                                            €
                                        </span>

                                    </div>

                                    <span class="text-muted fs-12">
                                        for @plan.DurationDays days
                                    </span>

                                </div>


                                <!-- Discount -->
                                @if (plan.DiscountPercent > 0)
                                {
                                    <div class="alert alert-success-transparent py-2 px-3 mb-4">

                                        <div class="d-flex align-items-center">

                                            <i class="ri-price-tag-3-line me-2"></i>

                                            <span class="fs-13">
                                                @plan.DiscountPercent% discount
                                            </span>

                                        </div>

                                    </div>
                                }


                                <!-- Features -->
                                @if (plan.Features != null && plan.Features.Any())
                                {
                                    <div class="mb-4">

                                        <h6 class="fw-semibold mb-3">
                                            Features
                                        </h6>

                                        <ul class="list-unstyled mb-0">

                                            @foreach (var feature in plan.Features)
                                            {
                                                <li class="d-flex align-items-center mb-2">

                                                    <span class="avatar avatar-xs bg-success-transparent text-success me-2">

                                                        <i class="ri-check-line"></i>

                                                    </span>

                                                    <span class="fs-13">
                                                        @feature.Name
                                                    </span>

                                                </li>
                                            }

                                        </ul>

                                    </div>
                                }
                                else
                                {
                                    <div class="mb-4">

                                        <h6 class="fw-semibold mb-3">
                                            Features
                                        </h6>

                                        <p class="text-muted fs-13 mb-0">
                                            No features configured.
                                        </p>

                                    </div>
                                }


                                <!-- Actions -->
                                <div class="d-grid gap-2 mt-auto">


                                    <!-- Edit -->
                                    <a asp-area="Admin"
                                       asp-controller="Subscriptions"
                                       asp-action="Edit"
                                       asp-route-id="@plan.Id"
                                       class="btn btn-primary">

                                        <i class="ri-edit-line me-1"></i>
                                        Edit Plan

                                    </a>


                                    <!-- Activate / Disable -->
                                    @if (plan.IsActive)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Subscriptions"
                                              asp-action="Delete"
                                              asp-route-id="@plan.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to disable this subscription plan?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-light w-100 text-danger">

                                                <i class="ri-close-circle-line me-1"></i>
                                                Disable Plan

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Subscriptions"
                                              asp-action="Activate"
                                              asp-route-id="@plan.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to activate this subscription plan?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-light w-100 text-success">

                                                <i class="ri-checkbox-circle-line me-1"></i>
                                                Activate Plan

                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>


                    index++;
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-xl-8">

                    <div class="card custom-card">

                        <div class="card-body text-center py-5">

                            <div class="avatar avatar-xl bg-primary-transparent text-primary mb-3">

                                <i class="ri-price-tag-3-line fs-32"></i>

                            </div>

                            <h5 class="fw-semibold">
                                No subscription plans
                            </h5>

                            <p class="text-muted mb-4">
                                There are currently no subscription plans available.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Subscriptions"
                               asp-action="Create"
                               class="btn btn-primary">

                                <i class="ri-add-line me-1"></i>
                                Create First Plan

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- Pagination -->
        @if (Model?.Plans != null && Model.Plans.TotalPages > 1)
        {
            <div class="card custom-card">

                <div class="card-body">

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">


                        <!-- Count -->
                        <div class="text-muted fs-13">

                            Showing
                            <strong>@Model.Plans.Items.Count</strong>
                            of
                            <strong>@Model.Plans.TotalCount</strong>
                            subscription plans

                        </div>


                        <!-- Pagination -->
                        <nav aria-label="Subscription plans pagination">

                            <ul class="pagination mb-0">


                                <!-- Previous -->
                                @if (Model.Plans.PageNumber > 1)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-area="Admin"
                                           asp-controller="Subscriptions"
                                           asp-action="Index"
                                           asp-route-page="@(Model.Plans.PageNumber - 1)"
                                           asp-route-pageSize="@Model.Plans.PageSize">

                                            <i class="ri-arrow-left-s-line"></i>

                                        </a>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">

                                            <i class="ri-arrow-left-s-line"></i>

                                        </span>

                                    </li>
                                }


                                <!-- Page Numbers -->
                                @for (var pageNumber = 1;
                                      pageNumber <= Model.Plans.TotalPages;
                                      pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Plans.PageNumber ? "active" : "")">

                                        <a class="page-link"
                                           asp-area="Admin"
                                           asp-controller="Subscriptions"
                                           asp-action="Index"
                                           asp-route-page="@pageNumber"
                                           asp-route-pageSize="@Model.Plans.PageSize">

                                            @pageNumber

                                        </a>

                                    </li>
                                }


                                <!-- Next -->
                                @if (Model.Plans.PageNumber < Model.Plans.TotalPages)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-area="Admin"
                                           asp-controller="Subscriptions"
                                           asp-action="Index"
                                           asp-route-page="@(Model.Plans.PageNumber + 1)"
                                           asp-route-pageSize="@Model.Plans.PageSize">

                                            <i class="ri-arrow-right-s-line"></i>

                                        </a>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">

                                            <i class="ri-arrow-right-s-line"></i>

                                        </span>

                                    </li>
                                }

                            </ul>

                        </nav>

                    </div>

                </div>

            </div>
        }

    </div>
</div>
