
@model Vyzor.Application.DTO.Appointment.AppointmentEditDTO

@using Vyzor.Application.DTO.Doctor

@{
    ViewData["Title"] = "Book Appointment";

    var doctor = ViewBag.Doctor as DoctorDetailsDTO;
}

<div class="doctor-content">
    <div class="container">

        <div class="row">
            <div class="col-lg-8 mx-auto">

                <form id="appointment-booking-form"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="DoctorId" type="hidden" />

                    <div class="card booking-card">

                        <div class="card-header">
                            <div class="booking-header">

                                <div class="card mb-0">
                                    <div class="card-body">

                                        <h4 class="mb-1">
                                            @doctor?.FullName
                                        </h4>

                                        <p class="text-indigo fw-medium mb-2">
                                            @doctor?.SpecializationName
                                        </p>

                                        <p class="mb-0">
                                            <i class="isax isax-location me-2"></i>
                                            @doctor?.Clinic
                                        </p>

                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="card-body booking-body">

                            <div id="appointment-cart-message"
                                 class="alert d-none"
                                 role="alert">
                            </div>

                            <div class="card">
                                <div class="card-body">

                                    <h5 class="mb-4">
                                        Appointment Information
                                    </h5>

                                    <div class="mb-3">

                                        <label asp-for="AppointmentDate"
                                               class="form-label">
                                            Appointment Date
                                        </label>

                                        <input asp-for="AppointmentDate"
                                               id="appointment-date"
                                               class="form-control"
                                               type="datetime-local" />

                                        <span asp-validation-for="AppointmentDate"
                                              class="text-danger">
                                        </span>

                                    </div>

                                    <div class="mb-3">

                                        <label asp-for="About"
                                               class="form-label">
                                            Reason for visit
                                        </label>

                                        <textarea asp-for="About"
                                                  class="form-control"
                                                  rows="4"
                                                  placeholder="Describe your problem"></textarea>

                                        <span asp-validation-for="About"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>
                            </div>

                        </div>

                        <div class="card-footer">

                            <div class="d-flex justify-content-end">

                                <button type="submit"
                                        id="add-to-cart-button"
                                        class="btn btn-primary-gradient rounded-pill">

                                    <span id="add-to-cart-text">
                                        Add to Cart
                                    </span>

                                    <span id="add-to-cart-loading"
                                          class="d-none">
                                        Adding...
                                    </span>

                                    <i id="add-to-cart-icon"
                                       class="isax isax-shopping-cart ms-2"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/appointment-create.js" asp-append-version="true"></script> }
}

