@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Vyzor Medical
    </title>

    <meta name="description"
          content="Vyzor Medical - medical center and online appointment system" />

    <link rel="shortcut icon"
          href="~/assets/img/favicon.png"
          type="image/x-icon" />


    <!-- Doccure styles -->
    <link rel="stylesheet"
          href="~/assets/Doccure/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/fontawesome/css/fontawesome.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/plugins/fontawesome/css/all.min.css" />


    <link rel="stylesheet"
          href="~/assets/Doccure/css/feather.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/select2.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/bootstrap-datetimepicker.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/owl.carousel.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/owl.theme.default.min.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/aos.css" />

    <link rel="stylesheet"
          href="~/assets/Doccure/css/style.css" />
    <link rel="stylesheet"
          href="~/assets/Doccure/css/icon-fix.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- Main wrapper -->
    <div class="main-wrapper">
        @await Html.PartialAsync("~/Views/Shared/_Header.cshtml")
      
 
     
        <!-- Main content -->
        <main role="main">
            @RenderBody()
        </main>

       
        

    </div>
    <!-- /Main wrapper -->
    <!-- Doccure JavaScript -->
    <script src="~/assets/Doccure/js/jquery-3.7.1.min.js"></script>
    <script src="~/assets/Doccure/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/Doccure/js/feather.min.js"></script>
    <script src="~/assets/Doccure/js/select2.min.js"></script>
    <script src="~/assets/Doccure/js/moment.min.js"></script>
    <script src="~/assets/Doccure/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/Doccure/js/owl.carousel.min.js"></script>
    <script src="~/assets/Doccure/js/slick.js"></script>
    <script src="~/assets/Doccure/js/aos.js"></script>
    <script src="~/assets/Doccure/js/counter.js"></script>
    <script src="~/assets/Doccure/js/backToTop.js"></script>
    <script src="~/assets/Doccure/js/script.js"></script>





    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>