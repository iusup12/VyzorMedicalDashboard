     tabindex="-1"
     id="support_item">

    <div class="offcanvas-header">

        <a href="/">

            <img src="/assets/Doccure/img/logo.svg"
                 alt="logo"
                 class="img-fluid logo">

        </a>


        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">

            <i class="isax isax-close-circle"></i>

        </button>

    </div>


    <div class="offcanvas-body">


        <!-- About -->
        <div class="about-popup-item">

            <h3 class="title">
                About Doccure
            </h3>

