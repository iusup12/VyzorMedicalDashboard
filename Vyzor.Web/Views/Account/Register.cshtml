                                                </span>

                                            </div>


                                            <span asp-validation-for="Password"
                                                  class="text-danger">
                                            </span>

                                        </div>
                                        <!-- /Password -->
                                        <!-- Confirm Password -->
                                        <div class="mb-3">

                                            <div class="form-group-flex">

                                                <label asp-for="ConfirmPassword"
