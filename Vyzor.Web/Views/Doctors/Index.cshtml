 @using System.Linq
@model IEnumerable<Vyzor.Application.DTO.Doctor.DoctorCardDTO>

@{
    ViewData["Title"] = "Doctors";
}

<!-- Main Wrapper -->
<div class="main-wrapper">

    <!-- Theme -->
    <div class="header-theme header-theme-two">
        <button type="button"
                id="dark-mode-toggle"
                class="theme-toggle moon"
                aria-label="dark mode">
            <i class="isax isax-moon5"></i>
        </button>

        <button type="button"
                id="light-mode-toggle"
                class="theme-toggle sun"
                aria-label="light mode">
            <i class="isax isax-sun-15"></i>
        </button>
    </div>
    <!-- /Theme -->
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar overflow-visible">

        <div class="container">

            <div class="row align-items-center inner-banner">

                <div class="col-md-12 col-12 text-center">

                    <nav aria-label="breadcrumb"
                         class="page-breadcrumb">

                        <ol class="breadcrumb">

                            <li class="breadcrumb-item">
                                <a href="/" aria-label="home">
                                    <i class="isax isax-home-15"></i>
                                </a>
                            </li>

                            <li class="breadcrumb-item">
                                Doctor
                            </li>

                            <li class="breadcrumb-item active">
                                Doctor Grid
                            </li>

                        </ol>

                        <h2 class="breadcrumb-title">
                            Doctor Grid
                        </h2>

                    </nav>

                </div>

            </div>


            <!-- Search -->
            <div class="bg-primary-gradient rounded-pill doctors-search-box">

                <div class="search-box-one rounded-pill">

                    <form method="get"
                          action="/Doctors/Index">

                        <div class="search-input search-line">

                            <i class="isax isax-hospital5 bficon"></i>

                            <div class="mb-0">

                                <input type="text"
                                       class="form-control"
                                       name="Search"
                                       placeholder="Search for Doctors, Hospitals, Clinics">

                            </div>

                        </div>


                        <div class="search-input search-map-line">

                            <i class="isax isax-location5"></i>

                            <div class="mb-0">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Location">

                            </div>

                        </div>


                        <div class="search-input search-calendar-line">

                            <i class="isax isax-calendar-tick5"></i>

                            <div class="mb-0">

                                <input type="text"
                                       class="form-control datetimepicker"
                                       placeholder="Date">

                            </div>

                        </div>


                        <div class="form-search-btn">

                            <button class="btn btn-primary d-inline-flex align-items-center rounded-pill"
                                    type="submit">

                                <i class="isax isax-search-normal-15 me-2"></i>

                                Search

                            </button>

                        </div>

                    </form>

                </div>

            </div>
            <!-- /Search -->

        </div>


        <div class="breadcrumb-bg">

            <img src="/assets/Doccure/img/bg/breadcrumb-bg-01.png"
                 alt="img"
                 class="breadcrumb-bg-01">

            <img src="/assets/Doccure/img/bg/breadcrumb-bg-02.png"
                 alt="img"
                 class="breadcrumb-bg-02">

            <img src="/assets/Doccure/img/bg/breadcrumb-icon.png"
                 alt="img"
                 class="breadcrumb-bg-03">

            <img src="/assets/Doccure/img/bg/breadcrumb-icon.png"
                 alt="img"
                 class="breadcrumb-bg-04">

        </div>

    </div>
    <!-- /Breadcrumb -->
    <!-- Doctors Content -->
    <div class="content mt-5">

        <div class="container">

            <!-- Header -->
            <div class="row align-items-center">

                <div class="col-md-6">

                    <div class="mb-4">

                        <h3 class="main-title">

                            Showing

                            <span class="text-secondary">
                                @Model.Count()
                            </span>

                            Doctors For You

                        </h3>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="d-flex align-items-center justify-content-end mb-4">


                        <!-- Availability -->
                        <div class="doctor-filter-availability me-2">

                            <p>
                                Availability
                            </p>

                            <div class="status-toggle status-tog">

                                <input type="checkbox"
                                       id="status_6"
                                       class="check">

                                <label for="status_6"
                                       class="checktoggle">
                                    checkbox
                                </label>

                            </div>

                        </div>
                        <!-- /Availability -->
                        <!-- Sort -->
                        <div class="dropdown header-dropdown me-2">

                            <a class="dropdown-toggle sort-dropdown"
                               data-bs-toggle="dropdown"
                               href="javascript:void(0);"
                               aria-expanded="false">

                                <span>
                                    Sort By
                                </span>

                                Price (Low to High)

                            </a>

                            <div class="dropdown-menu dropdown-menu-end">

                                <a href="javascript:void(0);"
                                   class="dropdown-item">

                                    Price (Low to High)

                                </a>

                                <a href="javascript:void(0);"
                                   class="dropdown-item">

                                    Price (High to Low)

                                </a>

                            </div>

                        </div>
                        <!-- /Sort -->
                        <!-- Grid -->
                        <a href="#"
                           class="btn btn-sm head-icon active me-2">

                            <i class="isax isax-grid-7"></i>

                        </a>


                        <!-- List -->
                        <a href="#"
                           class="btn btn-sm head-icon me-2">

                            <i class="isax isax-row-vertical"></i>

                        </a>


                        <!-- Map -->
                        <a href="#"
                           class="btn btn-sm head-icon">

                            <i class="isax isax-location"></i>

                        </a>

                    </div>

                </div>

            </div>
            <!-- /Header -->
            <!-- Doctors -->
            <div class="row">

                @if (Model.Any())
                {

                    @foreach (var doctor in Model)
                    {

                        <div class="col-xxl-4 col-md-6">

                            <div class="card">

                                <!-- Doctor Image -->
                                <div class="card-img card-img-hover">

                                    <a href="/Doctors/Details/@doctor.Id">

                                        <img src="@(string.IsNullOrWhiteSpace(doctor.PhotoUrl)
                                                                                                                                                                         ? "/assets/Doccure/img/doctor-grid/doctor-grid-01.jpg"
                                                                                                                                                                         : doctor.PhotoUrl)"
                                             alt="@doctor.FullName">

                                    </a>


                                    <div class="grid-overlay-item d-flex align-items-center justify-content-between">

                                        <span class="badge bg-orange">

                                            <i class="fa-solid fa-star me-1"></i>

                                            @doctor.Rating.ToString("0.0")

                                        </span>


                                        <a href="javascript:void(0)"
                                           class="fav-icon">

                                            <i class="fa fa-heart"></i>

                                        </a>

                                    </div>

                                </div>
                                <!-- /Doctor Image -->


                                <div class="card-body p-0">


                                    <!-- Specialization / Availability -->
                                    <div class="d-flex active-bar align-items-center justify-content-between p-3">

                                        <a href="javascript:void(0)"
                                           class="text-indigo fw-medium fs-14">

                                            @doctor.SpecializationName

                                        </a>


                                        <span class="badge bg-success-light d-inline-flex align-items-center">

                                            <i class="fa-solid fa-circle fs-5 me-1"></i>

                                            Available

                                        </span>

                                    </div>
                                    <!-- /Specialization / Availability -->


                                    <div class="p-3 pt-0">


                                        <!-- Doctor Information -->
                                        <div class="doctor-info-detail mb-3 pb-3">

                                            <h3 class="mb-1">

                                                <a href="/Doctors/Details/@doctor.Id">

                                                    @doctor.FullName

                                                </a>

                                            </h3>


                                            <div class="d-flex align-items-center">

                                                <p class="d-flex align-items-center mb-0 fs-14">

                                                    <i class="isax isax-location me-2"></i>

                                                    Minneapolis, MN

                                                </p>


                                                <i class="fa-solid fa-circle fs-5 text-primary mx-2 me-1"></i>


                                                <span class="fs-14 fw-medium">

                                                    30 Min

                                                </span>

                                            </div>

                                        </div>
                                        <!-- /Doctor Information -->
                                        <!-- Price / Booking -->
                                        <div class="d-flex align-items-center justify-content-between">

                                            <div>

                                                <p class="mb-1">
                                                    Consultation Fees
                                                </p>

                                                <h3 class="text-orange">
                                                    @doctor.AppointmentPrice.ToString("N0")
                                                    <span class="currency-rub">₽</span>
                                                </h3>
                                            </div>


                                            <a href="/Appointment/Create?doctorId=@doctor.Id"
                                               class="btn btn-md btn-dark d-inline-flex align-items-center rounded-pill">

                                                <i class="isax isax-calendar-1 me-2"></i>

                                                Book Now

                                            </a>

                                        </div>
                                        <!-- /Price / Booking -->

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                }
                else
                {

                    <div class="col-md-12">

                        <div class="text-center py-5">

                            <h3>
                                No doctors found
                            </h3>

                            <p class="text-muted">
                                There are currently no available doctors.
                            </p>

                        </div>

                    </div>

                }


                <!-- Load More -->
                <div class="col-md-12">

                    <div class="text-center mb-4">

                        <a href="javascript:void(0);"
                           class="btn btn-md btn-primary-gradient d-inline-flex align-items-center rounded-pill">

                            <i class="isax isax-d-cube-scan5 me-2"></i>

                            Load More

                        </a>

                    </div>

                </div>

            </div>
            <!-- /Doctors -->

        </div>

    </div>
    <!-- /Doctors Content -->
    <!-- Footer Section -->
    <footer class="footer inner-footer">

        <div class="footer-top">

            <div class="container">

                <div class="row">


                    <div class="col-xl-8">

                        <div class="row">


                            <!-- Company -->
